{
  "name": "certiflow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CertiFlow API and background workers",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/all-in-one.ts",
    "dev:api": "tsx watch src/server.ts",
    "start:local": "tsx src/all-in-one.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:all-in-one": "node dist/all-in-one.js",
    "worker:certificate": "node dist/workers/certificate.worker.js",
    "worker:delivery": "node dist/workers/delivery.worker.js",
    "worker:outbox": "node dist/workers/outbox.worker.js",
    "worker:scheduler": "node dist/workers/scheduler.worker.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed/run.ts",
    "db:seed:if-empty": "tsx src/seed/run.ts --if-empty",
    "db:reset-demo": "tsx src/seed/run.ts --reset",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "amqplib": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.2",
    "read-excel-file": "^9.3.20",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
