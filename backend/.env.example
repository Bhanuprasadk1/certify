# ==============================================================================
# CertiFlow Backend — Local Non-Docker Development Configuration Example
# ==============================================================================
# Only needed if running the backend directly via `npm run dev` or `npm test`
# outside Docker Compose. Copy to `backend/.env`.
#
# SECURITY WARNING: Development-only defaults. Replace all secrets in production.
# ==============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (local or remote database; TEST_DATABASE_URL is used by `npm test`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/certiflow
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/certiflow_test

# Authentication (MUST be >= 32 characters; replace in production)
JWT_ACCESS_SECRET=dev-only-change-in-production-certiflow-jwt-secret-min-32-chars
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
TRUST_PROXY=false

# CORS & QR Code Base URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173

# Rate Limiting
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
VERIFY_RATE_LIMIT=60

# Queue & Cache
# Use QUEUE_DRIVER=memory for zero-dependency local dev, or QUEUE_DRIVER=rabbitmq with RabbitMQ/Redis URLs
QUEUE_DRIVER=memory
REDIS_URL=
RABBITMQ_URL=

# Storage & Demo Settings (NEVER enable DEMO_MODE in production)
STORAGE_DIR=./storage
DEMO_MODE=true
DEMO_PASSWORD=Demo@1234
