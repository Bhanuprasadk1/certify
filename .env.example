# ==============================================================================
# CertiFlow — Environment Configuration Example (Docker Compose + App)
# ==============================================================================
# Quick Start (Fresh Clone):
#   cp .env.example .env
#   docker compose up --build
#
# SECURITY WARNING:
#   All values below are DEVELOPMENT / HACKATHON DEMO defaults ONLY.
#   NEVER reuse these passwords, secrets, or DEMO_MODE=true in production.
#   Generate strong random secrets (e.g. `openssl rand -hex 32`) for production.
# ==============================================================================

# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info

# --- Host Ports (change only if ports are already in use on your machine) ---
FRONTEND_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- PostgreSQL (Container Credentials) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=certiflow

# --- RabbitMQ (Container Credentials) ---
RABBITMQ_DEFAULT_USER=certiflow
RABBITMQ_DEFAULT_PASS=certiflow

# --- Backend Authentication & Security ---
# MUST be at least 32 characters; replace with a cryptographically random value in production
JWT_ACCESS_SECRET=dev-only-change-in-production-certiflow-jwt-secret-min-32-chars
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
TRUST_PROXY=true

# --- CORS & Public Verification URL (embedded in certificate QR codes) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_APP_URL=http://localhost:3000

# --- Rate Limiting ---
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
VERIFY_RATE_LIMIT=60

# --- Storage ---
STORAGE_DIR=/app/storage

# --- Demo Mode & Seeded Demo Account Password ---
# Set DEMO_MODE=false in production!
DEMO_MODE=true
DEMO_PASSWORD=Demo@1234

# --- Frontend Build-Time API URL ---
# Leave empty in Docker Compose so Nginx proxies /api and /socket.io to the API container.
VITE_API_URL=
